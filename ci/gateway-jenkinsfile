pipeline {
    agent any
    tools {
        maven 'maven'
    }

    environment {
        HARBOR_CREDS = credentials('harbor')

        IMAGE_TAG = "${BUILD_NUMBER}"

        FULL_IMAGE = "${HARBOR_URL}/${HARBOR_PROJECT}/${APP_NAME}:${IMAGE_TAG}"
    }

    stages {
        stage('Build Gateway') {
            steps {
                echo "🚀 开始编译 gateway 子项目..."
                sh 'mvn clean package -pl gateway -am -DskipTests'
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                echo "🐳 开始构建并推送镜像: ${FULL_IMAGE}"
                script {
                    sh """
                        # 1. 将打包好的 jar 复制到当前目录（假设 Dockerfile 在根目录）
                        cp gateway/target/*.jar ./app.jar

                        # 2. 使用凭据安全登录 Harbor（避免密码明文暴露在日志中）
                        echo "\${HARBOR_PASSWORD}" | docker login ${HARBOR_URL} -u \${HARBOR_USER} --password-stdin

                        # 3. 构建镜像
                        docker build -t ${FULL_IMAGE} .

                        # 4. 推送镜像到 Harbor
                        docker push ${FULL_IMAGE}

                        # 5. 登出并清理本地镜像，防止 Jenkins 磁盘爆满
                        docker logout ${HARBOR_URL}
                        docker rmi -f ${FULL_IMAGE}
                    """
                }
            }
        }
    }

    post {
        failure {
            echo "❌ 流水线执行失败，请检查控制台日志！"
        }
        always {
            // 构建结束后清理工作空间
            cleanWs()
        }
    }
}